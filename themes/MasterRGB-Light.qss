/* MasterRGB Light — conservative Qt skin, preserving custom-painted widgets. */
QMainWindow, QDialog { background-color: #F3F5F9; color: #202938; }
QMenuBar, QMenu { background-color: #FFFFFF; color: #202938; border: 1px solid #D6DCE7; }
QMenu::item { padding: 7px 22px; }
QMenu::item:selected { background-color: #E7E0FF; color: #30205F; }
QTabWidget::pane { background-color: #FFFFFF; border: 1px solid #D6DCE7; border-radius: 7px; top: -1px; }
QTabBar::tab { background-color: #E9EDF4; color: #536176; border: 1px solid #D6DCE7; border-bottom: none; border-top-left-radius: 7px; border-top-right-radius: 7px; padding: 8px 14px; margin-right: 3px; }
QTabBar::tab:selected { background-color: #FFFFFF; color: #262D3A; border-color: #7957E8; }
QTabBar::tab:hover:!selected { background-color: #F5F2FF; color: #30205F; }
QPushButton, QToolButton { background-color: #E8ECF4; color: #202938; border: 1px solid #CAD2E0; border-radius: 7px; padding: 7px 13px; }
QPushButton:hover, QToolButton:hover { background-color: #DDD5FF; border-color: #927AFF; }
QPushButton:pressed, QToolButton:pressed { background-color: #C6B8FF; }
QPushButton:disabled, QToolButton:disabled { background-color: #EFF1F5; color: #A3ACBA; border-color: #E0E4EC; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox { background-color: #FFFFFF; color: #202938; border: 1px solid #CAD2E0; border-radius: 6px; padding: 5px 7px; selection-background-color: #DCD2FF; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #7957E8; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #202938; border: 1px solid #CAD2E0; selection-background-color: #E7E0FF; }
QTreeView, QListView, QTableView, QTableWidget, QTreeWidget { background-color: #FFFFFF; alternate-background-color: #F4F6FA; color: #202938; border: 1px solid #D6DCE7; gridline-color: #E1E5EC; selection-background-color: #E7E0FF; }
QHeaderView::section { background-color: #E9EDF4; color: #39465A; border: none; border-right: 1px solid #D6DCE7; border-bottom: 1px solid #D6DCE7; padding: 7px; font-weight: 600; }
QCheckBox, QRadioButton { spacing: 7px; color: #303B4E; }
QSlider::groove:horizontal { height: 6px; background: #D5DBE6; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #7957E8; border-radius: 3px; }
QSlider::handle:horizontal { background: #FFFFFF; border: 2px solid #7957E8; width: 14px; margin: -6px 0; border-radius: 8px; }
QScrollBar:vertical { background: #F3F5F9; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #C2CAD7; min-height: 24px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #927AFF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #F3F5F9; height: 11px; margin: 0; }
QScrollBar::handle:horizontal { background: #C2CAD7; min-width: 24px; border-radius: 5px; }
QScrollBar::handle:horizontal:hover { background: #927AFF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QStatusBar { background: #FFFFFF; color: #647084; border-top: 1px solid #D6DCE7; }
QToolTip { background: #FFFFFF; color: #202938; border: 1px solid #927AFF; padding: 5px; }
QLabel#MasterRGBSupportTitle { color: #242B39; font-size: 20pt; font-weight: 700; }
QLabel#MasterRGBSupportDescription { color: #48556A; font-size: 11pt; }
QLabel#MasterRGBSupportNote { color: #68758A; font-size: 9pt; }
QPushButton#MasterRGBDonateButton { background-color: #6846D8; color: #FFFFFF; border: 1px solid #927AFF; padding: 11px 20px; font-weight: 700; }
QPushButton#MasterRGBDonateButton:hover { background-color: #795BE8; }
QPushButton#MasterRGBGithubButton { padding: 11px 20px; }
QWidget#MasterRGBSupportPage { background-color: #FFFFFF; }
QWidget#MasterRGBDashboardPage { background-color: #F7F8FB; }
QLabel#MasterRGBDashboardTitle { color: #202938; font-size: 22pt; font-weight: 700; }
QLabel#MasterRGBDashboardSubtitle { color: #647084; font-size: 10pt; }
QLabel#MasterRGBDashboardCount { color: #6846D8; font-size: 9pt; font-weight: 700; }
QFrame#MasterRGBDeviceCard { background-color: #FFFFFF; border: 1px solid #D6DCE7; border-radius: 10px; }
QLabel#MasterRGBDeviceCategory { color: #6846D8; font-size: 8pt; font-weight: 700; }
QLabel#MasterRGBDeviceName { color: #202938; font-size: 11pt; font-weight: 600; }
QPushButton#MasterRGBOpenDeviceButton { background-color: #E7E0FF; border-color: #927AFF; color: #30205F; }

QWidget#MasterRGBHomePage { background-color: #F7F8FB; }
QLabel#MasterRGBHomeTitle { color: #202938; font-size: 22pt; font-weight: 700; }
QLabel#MasterRGBHomeDescription { color: #5C697F; font-size: 10pt; }
QLabel#MasterRGBHomeCount { color: #6846D8; font-size: 9pt; font-weight: 700; }
QLabel#MasterRGBSupportLink { color: #5C697F; font-size: 9pt; }
QPushButton#MasterRGBHomeDevices { background-color: #6846D8; border-color: #927AFF; color: #FFFFFF; font-weight: 700; }
QPushButton#MasterRGBHomeSettings { }
QPushButton#MasterRGBHomeUpdates { }
QPushButton#MasterRGBUpdatesButton { }
QGroupBox { color: #39465A; border: 1px solid #D6DCE7; border-radius: 8px; margin-top: 12px; padding: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }

/* 0.4.0 dashboard profile panel and support QR */
QFrame#MasterRGBPanel { background-color: #FFFFFF; border: 1px solid #D6DCE7; border-radius: 10px; }
QLabel#MasterRGBPanelTitle { color: #202938; font-size: 12pt; font-weight: 700; }
QLabel#MasterRGBPanelHint { color: #647084; font-size: 9pt; }
QLabel#MasterRGBHomeProfileStatus { color: #6846D8; font-size: 9pt; }
QLabel#MasterRGBPayPalQr { background-color: #FFFFFF; border: 1px solid #D6DCE7; border-radius: 10px; }
QLabel#MasterRGBUpdateStatus { color: #4E39A8; font-size: 10pt; padding: 4px 0; }
QLabel#MasterRGBSupportText { color: #4A576B; font-size: 10pt; }
QPushButton#MasterRGBHomeApply { background-color: #6846D8; border-color: #927AFF; color: #FFFFFF; font-weight: 700; }
QPushButton#MasterRGBHomeApply:hover { background-color: #795BE8; }

/* 0.4.3 info panel in support tab */
QLabel#MasterRGBInfoKey { color: #5C697F; font-weight: 600; font-size: 10pt; min-width: 130px; }
QLabel#MasterRGBInfoVal { color: #202938; font-size: 10pt; }
QLabel#MasterRGBInfoVal a { color: #6846D8; text-decoration: none; }
QLabel#MasterRGBInfoVal a:hover { text-decoration: underline; }
QWidget#MasterRGBSupportContainer { background-color: transparent; }
QScrollArea#MasterRGBSupportScroll { background: transparent; border: none; }
